# ---------------------------------------------------------------
# Kleanet API — Environment Variables
# Copy this file to .env and fill in the values before running.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Odoo connection (JSON-RPC)
ODOO_URL=http://localhost:8068
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin

# JWT — secret must be at least 32 characters
JWT_SECRET=the_moment_to_understand_
JWT_EXPIRY=30m
REFRESH_EXPIRY=30d

# Redis
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------
# Optional — leave empty to disable the associated feature
# ---------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
